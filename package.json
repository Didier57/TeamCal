{
  "name": "teamcal",
  "version": "0.1.0",
  "private": true,
  "description": "TeamCal - application web de gestion de planning d'equipe",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "patch-package": "^8.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "better-sqlite3@13.0.3": true
  }
}
