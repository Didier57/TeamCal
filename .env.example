# TeamCal - configuration minimale de Docker Compose.
# Toute la configuration applicative (SMTP, langue, theme, categories,
# permissions, etc.) se fait dans l'interface d'administration : elle est
# stockee en base SQLite et non dans des variables d'environnement.

# Port HTTP publie sur l'hote
TEAMCAL_PORT=8080

# Version de l'image GHCR (latest ou un tag precis, par exemple 0.1.0)
TEAMCAL_VERSION=latest

# Fuseau horaire du conteneur
TZ=Europe/Paris
